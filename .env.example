# WaterWise AI - Environment Configuration Example
# Copy this file to .env and set your Google AI Studio API key.
# Do NOT commit your actual API key to source control!

# Primary Gemini API Key
GEMINI_API_KEY=

# Optional fallback variable recognized by Google SDK
GOOGLE_API_KEY=

# Configured Gemini Flash Model (default is gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
